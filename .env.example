# ==============================================================================
# THE GILDED ACE · Environment Configuration Template
# ==============================================================================

# 1. AI Copilots (Optional: live LLM integration, falls back to pre-verified engine if blank)
GEMINI_API_KEY=your_gemini_api_key_here
XAI_API_KEY=your_xai_api_key_here

# 2. MongoDB Atlas (Audit Cases & Scenario Persistence)
# Purpose: Dynamic document store for analyst investigations, flagged machines, and saved optimizer portfolios.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gilded_ace_intelligence

# 3. Databricks SQL Warehouse (Analytical Data Warehouse & Feature Store)
# Purpose: Cloud Delta Lake executing SQL queries over Gold feature tables and Silver cleaned views.
DATABRICKS_SERVER_HOSTNAME=dbc-xxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxx
DATABRICKS_TOKEN=dapi_xxxx

# 4. Server Configuration
PORT=8000
HOST=127.0.0.1
